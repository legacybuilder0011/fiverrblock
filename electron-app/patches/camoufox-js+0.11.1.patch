diff --git a/node_modules/camoufox-js/dist/webgl/sample.js b/node_modules/camoufox-js/dist/webgl/sample.js
index 3ac1706..443f3f1 100644
--- a/node_modules/camoufox-js/dist/webgl/sample.js
