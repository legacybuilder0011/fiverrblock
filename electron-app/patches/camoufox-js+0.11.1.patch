@@ -14,8 +14,18 @@ async function openDatabase(pathName) {
             DatabaseConstructor = DatabaseSync;
         }
         else {
-            const { default: BetterSqlite3 } = await import("better-sqlite3");
-            DatabaseConstructor = BetterSqlite3;
+            // Prefer Node's built-in SQLite (Node >= 22.13 / Electron 43) so we
+            // don't depend on the native better-sqlite3 binary, which needs a C++
