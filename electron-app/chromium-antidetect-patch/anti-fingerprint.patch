+BLINK_COMMON_EXPORT BASE_DECLARE_FEATURE(kFarbleCanvas);
+BLINK_COMMON_EXPORT BASE_DECLARE_FEATURE(kFarbleWebRTC);
+BLINK_COMMON_EXPORT BASE_DECLARE_FEATURE(kSpoofNavigator);
