+// Copyright 2026 The Antidetect Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license.
+//
+// Runtime gate for the WebRTC IP-leak suppression hook in
+// PeerConnectionDependencyFactory::CreatePortAllocator. Active only when BOTH:
+//   1. blink::features::kFarbleWebRTC is enabled, and
+//   2. a non-empty per-profile session token switch is present on the renderer
+//      command line.
+// Off by default; never alters ICE behavior for an unconfigured profile.
+
+#ifndef THIRD_PARTY_BLINK_RENDERER_MODULES_PEERCONNECTION_ANTIDETECT_WEBRTC_POLICY_H_
+#define THIRD_PARTY_BLINK_RENDERER_MODULES_PEERCONNECTION_ANTIDETECT_WEBRTC_POLICY_H_
+
+#include "third_party/blink/renderer/modules/modules_export.h"
+
+namespace blink {
+
+// UNIFIED session-token switch (orchestrator): identical value to the canvas
+// and navigator hooks, so one browser-appended switch marks a configured
+// profile for all of them. Presence (not value) is what this hook checks.
+inline constexpr char kMyAppSessionTokenSwitch[] = "antidetect-session-token";
+
+// True iff kFarbleWebRTC is enabled AND a non-empty session token is present.
+// Command line + FeatureList are immutable after renderer startup, so the
+// result is computed once and cached; safe on the signaling/renderer thread.
+MODULES_EXPORT bool ShouldSuppressNonProxiedWebRTC();
+
+}  // namespace blink
+
+#endif  // THIRD_PARTY_BLINK_RENDERER_MODULES_PEERCONNECTION_ANTIDETECT_WEBRTC_POLICY_H_
diff --git a/third_party/blink/renderer/modules/peerconnection/antidetect_webrtc_policy.cc b/third_party/blink/renderer/modules/peerconnection/antidetect_webrtc_policy.cc
new file mode 100644
--- /dev/null
+++ b/third_party/blink/renderer/modules/peerconnection/antidetect_webrtc_policy.cc
@@ -0,0 +1,38 @@
+// Copyright 2026 The Antidetect Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license.
+
+#include "third_party/blink/renderer/modules/peerconnection/antidetect_webrtc_policy.h"
+
+#include "base/command_line.h"
+#include "base/feature_list.h"
+#include "third_party/blink/public/common/features.h"
+
+namespace blink {
+
+namespace {
+
+bool ComputeSuppress() {
+  // The base::Feature state is serialized from the browser onto the renderer
+  // command line at launch, so IsEnabled() here returns the browser's answer.
+  if (!base::FeatureList::IsEnabled(features::kFarbleWebRTC))
+    return false;
+
+  // Require a non-empty per-profile session token. Feature on but token absent
+  // (unconfigured profile) => no-op; we never change ICE behavior blindly.
+  const base::CommandLine* command_line =
+      base::CommandLine::ForCurrentProcess();
+  return !command_line->GetSwitchValueASCII(kMyAppSessionTokenSwitch).empty();
+}
+
+}  // namespace
+
+bool ShouldSuppressNonProxiedWebRTC() {
+  // Write-once-before-threads-read; cache so repeated allocator creations pay
+  // the cost once and the value is stable/thread-safe for the process life.
+  static const bool kSuppress = ComputeSuppress();
+  return kSuppress;
+}
+
+}  // namespace blink
