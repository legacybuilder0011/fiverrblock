 namespace blink {
 
 unsigned NavigatorConcurrentHardware::hardwareConcurrency() const {
+  // Per-profile spoofed core count. This mixin is inherited by WorkerNavigator,
+  // so it can run on worker threads; Get() is a thread-safe magic-static read
+  // of a write-once command-line snapshot.
+  if (base::FeatureList::IsEnabled(features::kSpoofNavigator)) {
+    const AntidetectNavigatorConfig& config = AntidetectNavigatorConfig::Get();
