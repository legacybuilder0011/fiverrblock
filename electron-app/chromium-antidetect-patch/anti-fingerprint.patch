diff --git a/third_party/blink/renderer/core/farble/farble_session_cache.h b/third_party/blink/renderer/core/farble/farble_session_cache.h
new file mode 100644
--- /dev/null
+++ b/third_party/blink/renderer/core/farble/farble_session_cache.h
@@ -0,0 +1,66 @@
+// Copyright 2026 The Privacy Shield Authors.
+// Use of this source code is governed by a BSD-style license.
+//
+// Per-session, per-origin deterministic canvas farbling. Mirrors Brave's
+// brave_session_cache.{h,cc}: a Supplement<ExecutionContext> (one instance per
+// Document AND per worker/worklet global scope) seeded from a hash of
+// (top-frame registrable domain, per-profile session token). Reachable from
+// both frame and worker canvas code; each thread gets its own supplement
+// instance -> thread-safe with no shared mutable state.
+
+#ifndef THIRD_PARTY_BLINK_RENDERER_CORE_FARBLE_FARBLE_SESSION_CACHE_H_
+#define THIRD_PARTY_BLINK_RENDERER_CORE_FARBLE_FARBLE_SESSION_CACHE_H_
+
+#include <cstddef>
+#include <cstdint>
+#include <random>
+
+#include "base/memory/scoped_refptr.h"
+#include "third_party/blink/renderer/core/core_export.h"
+#include "third_party/blink/renderer/core/execution_context/execution_context.h"
+#include "third_party/blink/renderer/platform/heap/garbage_collected.h"
+#include "third_party/blink/renderer/platform/supplementable.h"
+
+namespace blink {
+
+class StaticBitmapImage;
+
+class CORE_EXPORT FarbleSessionCache final
+    : public GarbageCollected<FarbleSessionCache>,
+      public Supplement<ExecutionContext> {
+ public:
+  static const char kSupplementName[];
+
+  explicit FarbleSessionCache(ExecutionContext&);
+  FarbleSessionCache(const FarbleSessionCache&) = delete;
+  FarbleSessionCache& operator=(const FarbleSessionCache&) = delete;
+
+  // Supplement for |context|, created on first use. Returns nullptr when the
+  // context has no usable (non-opaque) origin (no stable seed). The (possibly
+  // invalid) supplement is cached either way, so repeat calls are cheap.
+  static FarbleSessionCache* From(ExecutionContext& context);
+
+  // True iff kFarbleCanvas is enabled AND a non-empty per-profile session token
+  // was supplied on the command line. False => every hook is a strict no-op.
+  static bool IsFarblingEnabled();
+
+  void Trace(Visitor*) const override;
+
+  // Deterministic per-(origin, session) perturbation of an interleaved,
+  // 8-bit-per-channel buffer, in place. Flips only the LSB of each channel byte
+  // (max +/-1, imperceptible, stable). Channel-order agnostic (RGBA or BGRA).
+  void PerturbPixels(unsigned char* data, size_t size);
+
+  // Reads |image| into a writable software SkBitmap, farbles it, returns a new
+  // immutable StaticBitmapImage. For toDataURL / toBlob (which do NOT share
+  // getImageData's buffer). Returns the original on any failure / invalid cache.
+  scoped_refptr<StaticBitmapImage> PerturbImage(
+      scoped_refptr<StaticBitmapImage> image);
+
+ private:
+  std::mt19937_64 MakePRNG() const;
+
+  // Per-profile token, delivered once on the renderer command line and cached
+  // process-wide (0 == "no token" -> farbling disabled).
+  static uint64_t SessionToken();
+
+  // 8-byte PRNG seed = HMAC-SHA256(session_token, registrable_domain)[0..8).
+  uint64_t domain_key_ = 0;
+  bool valid_ = false;
+};
+
+}  // namespace blink
+
+#endif  // THIRD_PARTY_BLINK_RENDERER_CORE_FARBLE_FARBLE_SESSION_CACHE_H_
diff --git a/third_party/blink/renderer/core/farble/farble_session_cache.cc b/third_party/blink/renderer/core/farble/farble_session_cache.cc
new file mode 100644
--- /dev/null
+++ b/third_party/blink/renderer/core/farble/farble_session_cache.cc
@@ -0,0 +1,140 @@
+// Copyright 2026 The Privacy Shield Authors.
+// Use of this source code is governed by a BSD-style license.
+
+#include "third_party/blink/renderer/core/farble/farble_session_cache.h"
+
+#include <cstring>
+#include <string_view>  // reviewer fix: crypto::HMAC::Sign(std::string_view,...)
+#include <utility>      // reviewer fix: std::move
+
+#include "base/command_line.h"
+#include "base/feature_list.h"
+#include "base/strings/string_number_conversions.h"
+#include "crypto/hmac.h"
+#include "third_party/blink/public/common/features.h"
+#include "third_party/blink/renderer/platform/graphics/static_bitmap_image.h"
+#include "third_party/blink/renderer/platform/graphics/unaccelerated_static_bitmap_image.h"
+#include "third_party/blink/renderer/platform/weborigin/security_origin.h"
+#include "third_party/blink/renderer/platform/wtf/text/string_utf8_adaptor.h"
+#include "third_party/skia/include/core/SkBitmap.h"
+#include "third_party/skia/include/core/SkColorSpace.h"
+#include "third_party/skia/include/core/SkImage.h"
+#include "third_party/skia/include/core/SkImageInfo.h"
+
+namespace blink {
+
+namespace {
+
+// UNIFIED session-token switch (orchestrator): the SAME switch gates canvas,
+// webrtc and navigator hooks. Appended once per profile by the browser in
+// ContentBrowserClient::AppendExtraCommandLineSwitches. Here the VALUE is also
+// used as the uint64 HMAC seed, so the browser must emit a decimal uint64.
+constexpr char kSessionTokenSwitch[] = "antidetect-session-token";
+
+}  // namespace
+
+// static
+const char FarbleSessionCache::kSupplementName[] = "FarbleSessionCache";
+
+// static
+uint64_t FarbleSessionCache::SessionToken() {
+  // Parsed once, before any script/worker runs, into a function-local static:
+  // write-once, read-only thereafter, lock-free.
+  static const uint64_t token = []() -> uint64_t {
+    const base::CommandLine* cmd = base::CommandLine::ForCurrentProcess();
+    uint64_t value = 0;
+    if (cmd->HasSwitch(kSessionTokenSwitch)) {
+      base::StringToUint64(cmd->GetSwitchValueASCII(kSessionTokenSwitch),
+                           &value);
+    }
+    return value;
+  }();
+  return token;
+}
+
+// static
+bool FarbleSessionCache::IsFarblingEnabled() {
+  return base::FeatureList::IsEnabled(features::kFarbleCanvas) &&
+         SessionToken() != 0u;
+}
+
+FarbleSessionCache::FarbleSessionCache(ExecutionContext& context)
+    : Supplement<ExecutionContext>(context) {
+  const SecurityOrigin* origin = context.GetSecurityOrigin();
+  if (!origin || origin->IsOpaque()) {
+    return;
+  }
+  // eTLD+1 keeps every subdomain of a site consistent; fall back to full host
+  // for hosts with no registrable domain (e.g. IP literals).
+  String domain = origin->RegistrableDomain();
+  if (domain.empty()) {
+    domain = origin->Host();
+  }
+  if (domain.empty()) {
+    return;
+  }
+  StringUTF8Adaptor domain_utf8(domain);
+
+  const uint64_t token = SessionToken();
+  crypto::HMAC hmac(crypto::HMAC::SHA256);
+  uint8_t digest[sizeof(domain_key_)] = {0};
+  // NOTE: if this tree's crypto roll dropped the raw-pointer Init/Sign
+  // overloads, switch to Init(base::byte_span_from_ref(token)) and
+  // Sign(<string_view>, base::span(digest)) (add base/containers/span.h).
+  if (hmac.Init(reinterpret_cast<const uint8_t*>(&token), sizeof(token)) &&
+      hmac.Sign(std::string_view(domain_utf8.data(), domain_utf8.size()),
+                digest, sizeof(digest))) {
+    std::memcpy(&domain_key_, digest, sizeof(domain_key_));
+    valid_ = true;
+  }
+}
+
+// static
+FarbleSessionCache* FarbleSessionCache::From(ExecutionContext& context) {
+  FarbleSessionCache* cache =
+      Supplement<ExecutionContext>::From<FarbleSessionCache>(context);
+  if (!cache) {
+    cache = MakeGarbageCollected<FarbleSessionCache>(context);
+    Supplement<ExecutionContext>::ProvideTo(context, cache);
+  }
+  return cache->valid_ ? cache : nullptr;
+}
+
+void FarbleSessionCache::Trace(Visitor* visitor) const {
+  Supplement<ExecutionContext>::Trace(visitor);
+}
+
+std::mt19937_64 FarbleSessionCache::MakePRNG() const {
+  return std::mt19937_64(domain_key_);
+}
+
+void FarbleSessionCache::PerturbPixels(unsigned char* data, size_t size) {
+  if (!valid_ || !data || size == 0) {
+    return;
+  }
+  std::mt19937_64 prng = MakePRNG();
+  uint64_t bit_pool = 0;
+  int bits_left = 0;
+  for (size_t i = 0; i < size; ++i) {
+    if (bits_left == 0) {
+      bit_pool = prng();
+      bits_left = 64;
+    }
+    data[i] ^= static_cast<unsigned char>(bit_pool & 0x1u);
+    bit_pool >>= 1;
+    --bits_left;
+  }
+}
+
+scoped_refptr<StaticBitmapImage> FarbleSessionCache::PerturbImage(
+    scoped_refptr<StaticBitmapImage> image) {
+  if (!valid_ || !image) {
+    return image;
+  }
+  sk_sp<SkImage> sk_image = image->PaintImageForCurrentFrame().GetSwSkImage();
+  if (!sk_image) {
+    return image;
+  }
+  // Unpremultiplied 8-bit RGBA so the LSB flip on a semi-transparent pixel
+  // doesn't get alpha-rounded away.
+  const SkImageInfo info = SkImageInfo::Make(
+      sk_image->width(), sk_image->height(), kRGBA_8888_SkColorType,
+      kUnpremul_SkAlphaType, sk_image->refColorSpace());
+  SkBitmap bitmap;
+  if (!bitmap.tryAllocPixels(info)) {
+    return image;
+  }
+  if (!sk_image->readPixels(bitmap.pixmap(), 0, 0)) {
+    return image;
+  }
+  PerturbPixels(static_cast<unsigned char*>(bitmap.getPixels()),
+                bitmap.computeByteSize());
+  bitmap.setImmutable();
+  sk_sp<SkImage> perturbed = SkImages::RasterFromBitmap(bitmap);
+  if (!perturbed) {
+    return image;
+  }
+  return UnacceleratedStaticBitmapImage::Create(std::move(perturbed));
+}
+
+}  // namespace blink
