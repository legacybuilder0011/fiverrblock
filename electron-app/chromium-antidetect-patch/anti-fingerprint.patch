+// Copyright 2026 The Privacy Shield Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license.
+
+#ifndef THIRD_PARTY_BLINK_RENDERER_CORE_FRAME_ANTIDETECT_NAVIGATOR_CONFIG_H_
+#define THIRD_PARTY_BLINK_RENDERER_CORE_FRAME_ANTIDETECT_NAVIGATOR_CONFIG_H_
+
+#include "base/no_destructor.h"
+#include "third_party/blink/renderer/core/core_export.h"
+#include "third_party/blink/renderer/platform/wtf/text/wtf_string.h"
+
+namespace blink {
+
+// Process-global, per-renderer (== per-profile) antidetect navigator config.
+// Delivered as command-line switches appended by the browser process:
+//   --antidetect-session-token=<uint64 decimal>  (presence == configured;
+//                                                  value is the shared seed)
+//   --antidetect-hw-concurrency=<unsigned>        (navigator.hardwareConcurrency)
+//   --antidetect-platform=<string>                (navigator.platform)
+//   --antidetect-user-agent=<string>             (navigator.userAgent)
+//
+// Snapshotted ONCE, on first access, into an immutable instance via a
+// magic-static: thread-safe C++11 init, then const forever. Safe from the
+// NavigatorConcurrentHardware / NavigatorID mixins, which also run on worker
+// threads (WorkerNavigator) with no Document to consult.
+//
+// Missing session token => unconfigured profile => every accessor reports
+// "absent" and callers fall through to real values.
+class CORE_EXPORT AntidetectNavigatorConfig {
+ public:
+  static const AntidetectNavigatorConfig& Get();
+
+  AntidetectNavigatorConfig(const AntidetectNavigatorConfig&) = delete;
+  AntidetectNavigatorConfig& operator=(const AntidetectNavigatorConfig&) =
+      delete;
+
+  bool HasSessionToken() const { return has_session_token_; }
+
+  bool HasHardwareConcurrency() const { return has_hw_concurrency_; }
+  unsigned HardwareConcurrency() const { return hw_concurrency_; }
+
+  bool HasPlatform() const { return !platform_.empty(); }
+  const String& Platform() const { return platform_; }
+
+  bool HasUserAgent() const { return !user_agent_.empty(); }
+  const String& UserAgent() const { return user_agent_; }
+
+ private:
+  friend class base::NoDestructor<AntidetectNavigatorConfig>;
+
+  AntidetectNavigatorConfig();
+  ~AntidetectNavigatorConfig();
+
+  bool has_session_token_ = false;
+  bool has_hw_concurrency_ = false;
+  unsigned hw_concurrency_ = 0;
+  String platform_;
+  String user_agent_;
+};
+
+}  // namespace blink
+
+#endif  // THIRD_PARTY_BLINK_RENDERER_CORE_FRAME_ANTIDETECT_NAVIGATOR_CONFIG_H_
