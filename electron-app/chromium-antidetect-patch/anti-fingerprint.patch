+// Copyright 2026 The Privacy Shield Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license.
+
+#include "third_party/blink/renderer/core/frame/antidetect_navigator_config.h"
+
+#include <string>
+
+#include "base/command_line.h"
+#include "base/no_destructor.h"
+#include "base/strings/string_number_conversions.h"
+
+namespace blink {
+
+namespace {
+
+// UNIFIED session-token switch: same value the canvas/webrtc hooks read.
+constexpr char kAntidetectSessionToken[] = "antidetect-session-token";
+constexpr char kAntidetectHwConcurrency[] = "antidetect-hw-concurrency";
+constexpr char kAntidetectPlatform[] = "antidetect-platform";
+constexpr char kAntidetectUserAgent[] = "antidetect-user-agent";
+
+}  // namespace
+
+// static
+const AntidetectNavigatorConfig& AntidetectNavigatorConfig::Get() {
+  static const base::NoDestructor<AntidetectNavigatorConfig> instance;
+  return *instance;
+}
+
+AntidetectNavigatorConfig::AntidetectNavigatorConfig() {
+  const base::CommandLine& cmd = *base::CommandLine::ForCurrentProcess();
+
+  const std::string token = cmd.GetSwitchValueASCII(kAntidetectSessionToken);
+  has_session_token_ = !token.empty();
+  if (!has_session_token_) {
+    return;  // Unconfigured profile: every field absent -> callers no-op.
+  }
+
+  const std::string hw = cmd.GetSwitchValueASCII(kAntidetectHwConcurrency);
+  unsigned parsed = 0;
+  if (!hw.empty() && base::StringToUint(hw, &parsed) && parsed > 0) {
+    hw_concurrency_ = parsed;
+    has_hw_concurrency_ = true;
+  }
+
+  // Portable form (reviewer note): String::FromUTF8(s.data(), s.size()) is safe
+  // across branches where FromUTF8(std::string_view) may not exist.
+  const std::string platform = cmd.GetSwitchValueASCII(kAntidetectPlatform);
+  platform_ = String::FromUTF8(platform.data(), platform.size());
+  const std::string ua = cmd.GetSwitchValueASCII(kAntidetectUserAgent);
+  user_agent_ = String::FromUTF8(ua.data(), ua.size());
+}
+
+AntidetectNavigatorConfig::~AntidetectNavigatorConfig() = default;
+
+}  // namespace blink
