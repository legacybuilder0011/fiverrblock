{
  "name": "privacy-shield",
  "version": "1.11.0",
  "description": "Privacy Shield Browser - Profile Identity Manager Desktop App",
  "author": "Privacy Shield",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:win": "node -e \"const fs=require('fs');const d='dist';if(fs.existsSync(d))fs.readdirSync(d).filter(f=>/\\.(exe|blockmap|yml)$/.test(f)).forEach(f=>fs.unlinkSync(d+'/'+f));\" && electron-builder --win"
  },
  "devDependencies": {
    "electron": "^31.3.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.privacyshield.app",
    "productName": "Privacy Shield Browser",
    "icon": "icons/icon256.png",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**",
      "renderer/**",
      "icons/**",
      "node_modules/**"
    ],
    "asarUnpack": [
      "renderer/**",
      "node_modules/cycletls/dist/**",
      "node_modules/node-forge/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.105.4",
    "cycletls": "^2.0.5",
    "extract-zip": "^2.0.1",
    "node-forge": "^1.4.0",
    "ssh2": "^1.17.0",
    "ws": "^8.20.1"
  }
}
