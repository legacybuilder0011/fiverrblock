# Copy this file to .env and fill in your values
# The server reads these environment variables on startup

# SOCKS5 port (default 1080)
PORT=1080

# HTTP CONNECT port (default 8080)
HTTP_PORT=8080

# Health/info API port (default 8888)
# The extension calls this to verify the server is alive
INFO_PORT=8888

# Authentication — leave blank to run as open proxy (not recommended)
PROXY_USER=myuser
PROXY_PASS=MyStrongPassword123!

# 2-letter country code where this server is located
# Used by the extension's proxy library auto-detect
# Examples: us, gb, de, nl, fr, ng, jp, sg, br, in, ae, ru, tr, ca, au
COUNTRY=us

# Max simultaneous connections (default 500)
MAX_CONNS=500

# Connection timeout in milliseconds (default 30000 = 30s)
TIMEOUT=30000
